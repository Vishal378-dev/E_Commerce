// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model product {
  id               String         @id @unique @default(uuid())
  isActive         Boolean
  sellerId         String
  asABrand         Boolean
  categoryId       String
  variantAttribute Json
  c_ts             DateTime       @default(now())
  u_ts             DateTime       @updatedAt
  variantTypes     variantTypes[]
}

model categoryId {
  id          Int      @id @default(autoincrement())
  name        String
  subCategory String
  c_ts        DateTime @default(now())
  u_ts        DateTime @updatedAt
}

model variant {
  id       Int      @id @default(autoincrement())
  name     String
  value    Json
  sellerId String
  c_ts     DateTime @default(now())
  u_ts     DateTime @updatedAt
}

model variantTypes {
  id            Int      @id @default(autoincrement())
  variantId     String   @unique
  name          String
  description   String
  price         Int
  stock         Int
  images        Json
  video         String
  wasPrice      Int
  weight        Float
  length        Float
  height        Float
  width         Float
  specification Json
  variantName   String
  product       product? @relation(fields: [productId], references: [id])
  productId     String?
  c_ts          DateTime @default(now())
  u_ts          DateTime @updatedAt
}
